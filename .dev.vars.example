# Secrets du Worker pour un essai à la main (npx wrangler dev, après SITE_MODE=preview npm run build). Copier en
# .dev.vars : ce fichier n'est jamais versionné. Pour essayer le site et ses formulaires, npm run trial suffit :
# il n'a besoin d'aucun secret et ne lit pas ce fichier. En production, ces valeurs sont des secrets du Worker.

# Mode d'essai, jamais en production : inscriptions et messages de contact gardés en mémoire, sans appeler
# Brevo. Seul ce mode admet les clés d'essai de Turnstile.
MEMORY_SERVICES=true

# Facultative en mode d'essai. Absente, ou clé d'essai 1x…, la vérification réussit, simulée sans appel à
# Cloudflare; 2x… : échec; 3x… : jeton déjà utilisé. La construction d'aperçu pose d'office la clé de site
# d'essai 1x00000000000000000000AA : ne la saisissez jamais dans config/services.json. Le navigateur charge
# tout de même le script du widget depuis challenges.cloudflare.com. En production, la clé secrète du widget.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sel des empreintes (adresse IP de la preuve de consentement, clés de débit) : une suite aléatoire d'au moins
# 32 caractères, par exemple produite par « openssl rand -hex 32 ».
IP_HASH_SALT=remplacer-par-une-suite-aleatoire-de-32-caracteres

# Clé d'API de Brevo (inscriptions à l'infolettre et messages du formulaire de contact).
NEWSLETTER_API_KEY=

# Facultatif : adresse qui reçoit les messages du formulaire de contact (sinon, le courriel de contact de
# config/site.json).
CONTACT_TO=

# Deploy Hook de Workers Builds (publication programmée, reconstruction nocturne).
DEPLOY_HOOK_URL=
