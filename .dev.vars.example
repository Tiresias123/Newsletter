# Secrets du Worker pour un essai local (npx wrangler dev, après npm run build). Copier en .dev.vars : ce fichier
# n'est jamais versionné. En production, ces valeurs sont des secrets du Worker dans Cloudflare.

# Essai local seulement, jamais en production : inscriptions et messages de contact gardés en mémoire, sans
# appeler Brevo. Seul ce mode admet les clés d'essai de Turnstile.
MEMORY_SERVICES=true

# Clé secrète d'essai de Turnstile qui accepte toujours le jeton factice de la clé de site d'essai
# 1x00000000000000000000AA (à saisir dans config/services.json le temps de l'essai). En production, la clé
# secrète du widget du site. La vérification appelle challenges.cloudflare.com : il faut un accès réseau.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sel des empreintes (adresse IP de la preuve de consentement, clés de débit) : une suite aléatoire d'au moins
# 32 caractères, par exemple produite par « openssl rand -hex 32 ».
IP_HASH_SALT=remplacer-par-une-suite-aleatoire-de-32-caracteres

# Clé d'API de Brevo (inscriptions à l'infolettre et messages du formulaire de contact).
NEWSLETTER_API_KEY=

# Facultatif : adresse qui reçoit les messages du formulaire de contact (sinon, le courriel de contact de
# config/site.json).
CONTACT_TO=

# Deploy Hook de Workers Builds (publication programmée, reconstruction nocturne).
DEPLOY_HOOK_URL=
