# Copier en .env pour un usage local (le fichier .env n'est jamais versionné). En production, ces variables
# sont réglées dans Cloudflare (Workers Builds, variables de construction), jamais dans le dépôt.

# Mode de construction : vide pour la production, « preview » pour une version d'aperçu
# (brouillons et contenus programmés visibles, pages en noindex).
SITE_MODE=

# Clé « Demo » de CoinGecko, lue pendant la construction seulement (bandeau des cours et sections de marché,
# s'ils sont activés). Sans elle, ces modules sont absents du site.
COINGECKO_API_KEY=
