---
// Veille officielle (brief 7.1 et 8.4) : publications des autorités relevées par le script veille:fetch.
import EmptyState from '../components/editorial/EmptyState.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import VeilleList from '../components/lists/VeilleList.astro';
import NewsletterBox from '../components/sidebar/NewsletterBox.astro';
import UpcomingList from '../components/sidebar/UpcomingList.astro';
import ListLayout from '../layouts/ListLayout.astro';
import { getConfig } from '../lib/config/index.ts';
import { getGraph } from '../lib/content/astro.ts';
import { forHub, hubUrl } from '../lib/content/breadcrumbs.ts';
import { upcomingAgenda } from '../lib/content/relations.ts';
import { veilleItems } from '../lib/content/veille.ts';
import { t } from '../lib/i18n.ts';
import { webPageJsonLd } from '../lib/seo/json-ld.ts';

const graph = await getGraph();
const { site } = getConfig();
const items = veilleItems();
const title = t('hubs.veille.title');
const description = t('hubs.veille.description');
---

<ListLayout crumbs={forHub('veille')} seo={{ title, description, jsonLd: [webPageJsonLd(site.url, { type: 'CollectionPage', path: hubUrl('veille'), name: title, description })] }}>
  <PageHeader slot="header" title={title} description={description}>
    <p class="text-sm text-meta">{t('veille.intro')}</p>
  </PageHeader>
  {items.length > 0 ? <VeilleList items={items} /> : <EmptyState message={t('veille.empty')} />}
  <Fragment slot="aside">
    <UpcomingList entries={upcomingAgenda(graph)} />
    <NewsletterBox />
  </Fragment>
</ListLayout>
