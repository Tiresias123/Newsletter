---
// Index des guides : /guides/ et ses pages, du plus récent au plus ancien.
import CardListPage from '../../components/lists/CardListPage.astro';
import { getGraph } from '../../lib/content/astro.ts';
import { forHub, hubUrl } from '../../lib/content/breadcrumbs.ts';
import { articleCard } from '../../lib/content/cards.ts';
import { t } from '../../lib/i18n.ts';
import { pagedPaths } from '../../lib/lists.ts';

export async function getStaticPaths() {
  const graph = await getGraph();
  return pagedPaths({}, graph.listed('guides').length);
}

const graph = await getGraph();
const { current } = Astro.props as { current: number };
---

<CardListPage
  title={t('hubs.guides.title')}
  description={t('hubs.guides.description')}
  crumbs={forHub('guides')}
  base={hubUrl('guides')}
  current={current}
  cards={graph.listed('guides').map((e) => articleCard(graph, e))}
/>
