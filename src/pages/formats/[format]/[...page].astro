---
// Contenus d'un format : /formats/[format]/ et ses pages. Hors des moteurs sous trois contenus (ARCHITECTURE 8.2).
import CardListPage from '../../../components/lists/CardListPage.astro';
import { getGraph } from '../../../lib/content/astro.ts';
import { home } from '../../../lib/content/breadcrumbs.ts';
import { articleCard } from '../../../lib/content/cards.ts';
import { editorialWithFormat } from '../../../lib/content/relations.ts';
import { t } from '../../../lib/i18n.ts';
import { pagedPaths, THIN_LIST } from '../../../lib/lists.ts';

export async function getStaticPaths() {
  const graph = await getGraph();
  return graph.all('formats').flatMap((format) => pagedPaths({ format: format.id }, editorialWithFormat(graph, format.id).length));
}

const graph = await getGraph();
const { current } = Astro.props as { current: number };
const format = graph.get('formats', Astro.params.format);
if (!format) throw new Error(`Format introuvable : ${Astro.params.format}.`);
const entries = editorialWithFormat(graph, format.id);
const title = t('hubs.format.title', { label: format.data.label });
---

<CardListPage
  title={title}
  description={format.data.description || t('hubs.format.description', { label: format.data.label })}
  crumbs={[home(), { label: title }]}
  base={format.url ?? '/'}
  current={current}
  cards={entries.map((e) => articleCard(graph, e))}
  filters={{ format: format.id }}
  seo={{ noindex: entries.length < THIN_LIST }}
/>
