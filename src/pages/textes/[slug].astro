---
// Fiche d'un texte officiel (brief 6.6) : type, émetteur, références et dates, lien vers le texte officiel et
// sa copie archivée, dispositions clés, présentation, dossiers et articles qui le citent.
import CardGrid from '../../components/cards/CardGrid.astro';
import DisclaimerBox from '../../components/editorial/DisclaimerBox.astro';
import KeyPoints from '../../components/editorial/KeyPoints.astro';
import LinkList from '../../components/editorial/LinkList.astro';
import PageSection from '../../components/editorial/PageSection.astro';
import ShareButtons from '../../components/editorial/ShareButtons.astro';
import FicheHeader from '../../components/fiche/FicheHeader.astro';
import { mdxComponents } from '../../components/mdx/index.ts';
import FeaturedDossiers from '../../components/sidebar/FeaturedDossiers.astro';
import NewsletterBox from '../../components/sidebar/NewsletterBox.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import JurisdictionBadge from '../../components/ui/JurisdictionBadge.astro';
import PreviewBadge from '../../components/ui/PreviewBadge.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import FicheLayout from '../../layouts/FicheLayout.astro';
import { getConfig } from '../../lib/config/index.ts';
import { getGraph, renderEntry } from '../../lib/content/astro.ts';
import { breadcrumbs } from '../../lib/content/breadcrumbs.ts';
import type { LegalStatus } from '../../lib/content/enums.ts';
import { texteView } from '../../lib/content/fiches.ts';
import { enumLabel, t } from '../../lib/i18n.ts';
import { webPageJsonLd } from '../../lib/seo/json-ld.ts';
import { ogImagePath } from '../../lib/seo/meta.ts';
import { pageToc } from '../../lib/toc.ts';

export async function getStaticPaths() {
  const graph = await getGraph();
  return graph
    .all('textes')
    .filter((e) => e.visibility.visible)
    .map((e) => ({ params: { slug: e.id } }));
}

const graph = await getGraph();
const entry = graph.get('textes', Astro.params.slug);
if (!entry) throw new Error(`Texte introuvable : ${Astro.params.slug}.`);
const { site } = getConfig();
const d = entry.data;
const view = texteView(graph, entry);
const { Content, headings } = await renderEntry('textes', entry.id);
const path = entry.url ?? '/';

const { toc, id } = pageToc(
  headings,
  [{ id: 'dispositions-cles', title: t('texte.keyProvisions'), show: d.keyProvisions.length > 0 }],
  [
    { id: 'dossiers', title: t('texte.dossiers'), show: view.dossiers.length > 0 },
    { id: 'articles', title: t('texte.articles'), show: view.articles.length > 0 },
  ],
);

const seo = {
  title: d.seo?.title || d.title,
  description: d.seo?.description || d.summary,
  canonical: d.seo?.canonical,
  noindex: d.seo?.noindex,
  image: ogImagePath(path),
  imageAlt: d.title,
  jsonLd: [
    webPageJsonLd(site.url, {
      path,
      name: d.title,
      description: d.summary,
      about: {
        '@type': 'Legislation',
        name: d.title,
        url: d.officialUrl,
        ...(d.documentNumber && { legislationIdentifier: d.documentNumber }),
        ...(d.adoptedAt && { legislationDate: d.adoptedAt }),
      },
    }),
  ],
};
---

<FicheLayout crumbs={breadcrumbs.texte(entry)} seo={seo} identity={view.identity} toc={toc} searchType={t('search.types.textes')}>
  <div slot="header" class="space-y-5">
    <FicheHeader title={d.title} lead={d.summary}>
      <Fragment slot="badges">
        <Badge label={enumLabel('textType', d.type)} styleClass="badge--ardoise" />
        {d.legalStatus && <StatusBadge status={d.legalStatus as LegalStatus} />}
        {view.jurisdictions.map((j) => <JurisdictionBadge jurisdiction={j} link />)}
        {entry.visibility.previewOnly && <PreviewBadge state={entry.visibility.state === 'programme' ? 'programme' : 'brouillon'} />}
      </Fragment>
      <div class="flex flex-wrap gap-2 pt-1">
        <Button href={d.officialUrl} variant="primary" icon="landmark" external>{t('texte.officialText')}</Button>
        {d.archivedUrl && <Button href={d.archivedUrl} variant="ghost" icon="archive" external>{t('texte.archivedCopy')}</Button>}
      </div>
    </FicheHeader>
    <ShareButtons title={d.title} print />
  </div>

  <KeyPoints points={d.keyProvisions} title={t('texte.keyProvisions')} id={id('dispositions-cles')} class="" />
  <div class="prose">
    <Content components={mdxComponents} />
  </div>
  {
    view.dossiers.length > 0 && (
      <PageSection id={id('dossiers')} title={t('texte.dossiers')}>
        <LinkList items={view.dossiers} />
      </PageSection>
    )
  }
  {
    view.articles.length > 0 && (
      <PageSection id={id('articles')} title={t('texte.articles')}>
        <CardGrid cards={view.articles} variant="horizontal" />
      </PageSection>
    )
  }

  <Fragment slot="end">{view.disclaimer && <DisclaimerBox disclaimer={view.disclaimer} />}</Fragment>
  <Fragment slot="aside-bottom">
    <FeaturedDossiers />
    <NewsletterBox />
  </Fragment>
</FicheLayout>
