---
// Page introuvable.
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n.ts';
---

<BaseLayout title={t('notFound.title')} noindex>
  <div class="page-container py-20">
    <h1 class="text-4xl">{t('notFound.title')}</h1>
    <p class="mt-4 max-w-[var(--reading-w)] text-lg text-secondary">{t('notFound.text')}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" icon="house">{t('notFound.home')}</Button>
      <Button href="/recherche/" variant="ghost" icon="search">{t('notFound.search')}</Button>
    </div>
  </div>
</BaseLayout>
