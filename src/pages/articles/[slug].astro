---
// Page d'un article : /articles/[slug]/ (option C des adresses, ARCHITECTURE section 8).
import EditorialPage from '../../components/article/EditorialPage.astro';
import { getGraph } from '../../lib/content/astro.ts';
import { breadcrumbs } from '../../lib/content/breadcrumbs.ts';

export async function getStaticPaths() {
  const graph = await getGraph();
  return graph
    .all('articles')
    .filter((e) => e.visibility.visible)
    .map((e) => ({ params: { slug: e.id } }));
}

const graph = await getGraph();
const entry = graph.get('articles', Astro.params.slug);
if (!entry) throw new Error(`Article introuvable : ${Astro.params.slug}.`);
---

<EditorialPage entry={entry} crumbs={breadcrumbs.article(graph, entry)} />
