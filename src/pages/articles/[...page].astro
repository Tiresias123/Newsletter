---
// Tous les articles, du plus récent au plus ancien : /articles/ et /articles/page/[n]/.
import CardListPage from '../../components/lists/CardListPage.astro';
import { getGraph } from '../../lib/content/astro.ts';
import { forHub, hubUrl } from '../../lib/content/breadcrumbs.ts';
import { articleCard } from '../../lib/content/cards.ts';
import { t } from '../../lib/i18n.ts';
import { pagedPaths } from '../../lib/lists.ts';

export async function getStaticPaths() {
  const graph = await getGraph();
  return pagedPaths({}, graph.listed('articles').length);
}

const graph = await getGraph();
const { current } = Astro.props as { current: number };
---

<CardListPage
  title={t('hubs.articles.title')}
  description={t('hubs.articles.description')}
  crumbs={forHub('articles')}
  base={hubUrl('articles')}
  current={current}
  cards={graph.listed('articles').map((e) => articleCard(graph, e))}
  filters={{}}
/>
