---
// Rapport « À vérifier » en direct, recalculé à chaque visite (développement seulement).
// Mode aperçu par défaut, comme le serveur de développement ; « ?mode=production » montre ce que verra le build.
import BaseLayout from '../layouts/BaseLayout.astro';
import { runCheck } from '../lib/check/index.ts';
import { generatedLine, groupProblems, summaryLine } from '../lib/check/report.ts';
import { t } from '../lib/i18n.ts';

const mode = Astro.url.searchParams.get('mode') === 'production' ? 'production' : 'apercu';
const other = mode === 'production' ? 'apercu' : 'production';
const result = await runCheck({ root: process.cwd(), mode });
const sections = groupProblems(result.problems);
---

<BaseLayout title={t('report.title')} noindex>
  <div class="page-container py-10">
    <h1 class="text-4xl">{t('report.title')}</h1>
    <p class="mt-3 max-w-reading text-secondary">{t('report.devOnly')}</p>
    <p class="mt-1 text-sm text-meta">{generatedLine(result)}</p>
    <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
      <strong>{summaryLine(result.problems)}</strong>
      <a class="text-link" href={other === 'production' ? '?mode=production' : '?'}>{t('report.showMode', { mode: t(`report.modes.${other}`) })}</a>
    </p>
    {
      sections.map((section) => (
        <section class="mt-10" aria-labelledby={`gravite-${section.severity}`}>
          <h2 id={`gravite-${section.severity}`} class="text-2xl">
            {section.title} ({section.count})
          </h2>
          {section.help && <p class="mt-1 text-secondary">{section.help}</p>}
          {section.count === 0 && <p class="mt-3">{t('report.none')}</p>}
          {section.groups.map((group) => (
            <details class="mt-4 rounded-card border border-subtle bg-surface p-4" open={section.severity !== 'information'}>
              <summary class="cursor-pointer font-heading text-lg font-bold">
                {group.title} ({group.problems.length})
              </summary>
              <ul class="mt-3 divide-y divide-subtle text-sm">
                {group.problems.map((p) => (
                  <li class="py-2">
                    <code class="break-all">{p.file}</code>
                    <span class="text-meta"> — {p.field}</span>
                    <p class="mt-0.5">{p.message}</p>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
