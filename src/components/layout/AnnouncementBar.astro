---
// Bandeau d'annonce sous l'en-tête, activable dans config/site.json (non refermable en v1).
import { getConfig } from '../../lib/config/index.ts';
import { t } from '../../lib/i18n.ts';
import { frenchTypography } from '../../lib/typo.ts';
import Icon from '../ui/Icon.astro';

const { announcement } = getConfig().site;
---

{
  announcement.enabled && (
    <aside aria-label={t('announcement.label')} class="on-brand bg-brand-800 text-white">
      <div class="page-container flex min-h-10 flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2 text-center text-sm">
        <p>{frenchTypography(announcement.message)}</p>
        {announcement.linkUrl && announcement.linkLabel && (
          <a href={announcement.linkUrl} class="inline-flex items-center gap-1 font-semibold underline underline-offset-2">
            {frenchTypography(announcement.linkLabel)}
            <Icon name="arrow-right" size={16} />
          </a>
        )}
      </div>
    </aside>
  )
}
