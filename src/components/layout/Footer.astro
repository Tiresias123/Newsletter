---
// Pied de page sur fond bleu nuit : présentation, colonnes de liens (config/navigation.json),
// infolettre, réseaux, copyright et lieu d'hébergement des données.
import { getConfig } from '../../lib/config/index.ts';
import { t } from '../../lib/i18n.ts';
import { frenchTypography } from '../../lib/typo.ts';
import NewsletterForm from '../newsletter/NewsletterForm.astro';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';

const { site, navigation } = getConfig();
const columns = navigation.footer.map((c) => ({ ...c, links: c.links.filter((l) => l.enabled) })).filter((c) => c.links.length > 0);
const socials = site.socials.filter((s) => s.enabled && s.url);
const year = new Date().getFullYear();
---

<footer class="on-brand bg-brand-section text-white">
  <div class="page-container grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(3,1fr)_1.5fr]">
    <div class="space-y-4">
      <Logo inverse />
      <p class="text-sm text-meta-inverse">{frenchTypography(site.baseline)}</p>
      {
        socials.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label={t('footer.socialTitle')}>
            {socials.map((s) => (
              <li>
                <a href={s.url} class="btn-pill inline-flex items-center gap-1.5 rounded-pill border px-3 py-1 text-sm">
                  {s.network === 'rss' && <Icon name="rss" size={16} />}
                  {t(`social.${s.network}` as const)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="font-body text-sm font-bold">{column.title}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a href={link.url} class="text-meta-inverse hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <div>
      <h2 class="font-body text-sm font-bold">{t('footer.newsletterTitle')}</h2>
      <div class="mt-3"><NewsletterForm id="infolettre-pied" variant="compact" inverse /></div>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="page-container flex flex-wrap justify-between gap-2 py-4 text-xs text-meta-inverse">
      <p>{t('footer.copyright', { year, holder: site.copyrightHolder || site.name })}</p>
      {site.dataHosting && <p>{t('footer.dataHosting', { place: site.dataHosting })}</p>}
    </div>
  </div>
</footer>
