---
// Variation sur 24 heures : flèche, signe et couleur (jamais la couleur seule, DA section 10), texte complet
// pour les lecteurs d'écran.
import { formatPercent } from '../../lib/format.ts';
import { t } from '../../lib/i18n.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  change: number | null;
}

const { change } = Astro.props;
const rounded = change === null ? null : Math.round(change * 10) / 10;
const value = rounded === null ? '' : formatPercent(rounded, { decimals: 1, signed: true });
const label = rounded === null ? '' : rounded > 0 ? t('market.up', { value }) : rounded < 0 ? t('market.down', { value }) : t('market.flat');
---

{
  rounded !== null && (
    <span class:list={['inline-flex items-center gap-0.5 font-semibold tabular-nums', rounded > 0 && 'text-success', rounded < 0 && 'text-danger']}>
      {rounded !== 0 && <Icon name={rounded > 0 ? 'trending-up' : 'trending-down'} size={14} />}
      <span aria-hidden="true">{value}</span>
      <span class="sr-only">{label}</span>
    </span>
  )
}
