---
// Carte d'un cryptoactif (sections « market-brief » et « trending-assets », DA section 8.2) : cours en $ CA,
// variation sur 24 heures, courbe des sept derniers jours (décorative), heure des données.
import { formatMoney } from '../../lib/format.ts';
import { t } from '../../lib/i18n.ts';
import { sparklinePath, type Quote } from '../../lib/market/coingecko.ts';
import QuoteChange from './QuoteChange.astro';

interface Props {
  quote: Quote;
  // Carte large avec courbe (« en bref ») ou compacte.
  size?: 'large' | 'compact';
}

const { quote, size = 'compact' } = Astro.props;
const path = sparklinePath(quote.sparkline, 200, 48);
const rising = quote.sparkline.length > 1 && (quote.sparkline.at(-1) ?? 0) >= (quote.sparkline[0] ?? 0);
---

<article class="rounded-card border border-border bg-surface p-4">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-base">
      {quote.label} <span class="font-normal text-meta">{quote.symbol}</span>
    </h3>
    <QuoteChange change={quote.change24h} />
  </div>
  <p class:list={['mt-2 font-bold tabular-nums', size === 'large' ? 'text-2xl' : 'text-xl']}>{formatMoney(quote.price, { decimals: quote.price >= 100 ? 0 : 2 })}</p>
  {
    path && (
      <svg viewBox="0 0 200 48" preserveAspectRatio="none" class:list={['mt-3 w-full', size === 'large' ? 'h-16' : 'h-10', rising ? 'text-success' : 'text-danger']} role="img" aria-label={t('market.sparkline')}>
        <path d={path} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
</article>
