---
// Formulaire d'inscription à l'infolettre : textes lus dans config/newsletter.json, envoi vers /api/newsletter
// (Worker) avec double consentement. Preuve de consentement : page, emplacement et version du texte affiché.
// Turnstile se charge à la première interaction; champ piège contre les robots.
import { getConfig } from '../../lib/config/index.ts';
import { turnstileSiteKey } from '../../lib/forms/site-key.ts';
import { t } from '../../lib/i18n.ts';
import { displayedConsent } from '../../lib/newsletter/consent.ts';
import { frenchTypography } from '../../lib/typo.ts';
import Button from '../ui/Button.astro';

type Placement = 'article' | 'barre-laterale' | 'page' | 'pied-de-page' | 'accueil';

interface Props {
  // Identifiant unique dans la page (plusieurs formulaires peuvent coexister).
  id: string;
  variant?: 'band' | 'compact' | 'inline' | 'page';
  inverse?: boolean;
  list?: string;
  // Emplacement du formulaire, enregistré avec le consentement; déduit de la variante par défaut.
  placement?: Placement;
}

const PLACEMENTS: Record<NonNullable<Props['variant']>, Placement> = { band: 'accueil', compact: 'barre-laterale', inline: 'article', page: 'page' };
const { id, variant = 'inline', inverse = false } = Astro.props;
const placement = Astro.props.placement ?? PLACEMENTS[variant];
const { newsletter, site } = getConfig();
// Sans liste précisée : la première liste active (le Worker refuse une liste désactivée).
const list = Astro.props.list ?? newsletter.lists.find((l) => l.enabled)?.id ?? '';
const texts = newsletter.texts;
const { text: consent, version } = displayedConsent(texts, site.name);
const messages = {
  sending: t('forms.sending'),
  success: frenchTypography(texts.success),
  error: frenchTypography(texts.error),
  verification: t('forms.verification'),
  challenge: t('forms.challenge'),
  debit: t('forms.rateLimited'),
  network: t('forms.network'),
  invalide: t('forms.invalid'),
};
const stacked = variant === 'compact';
---

<form
  action="/api/newsletter"
  method="post"
  class:list={['space-y-3', inverse && 'form-inverse']}
  data-site-form
  data-action="newsletter"
  data-event="newsletterSignup"
  data-placement={placement}
  data-sitekey={turnstileSiteKey()}
  data-messages={JSON.stringify(messages)}
>
  <input type="hidden" name="list" value={list} />
  <input type="hidden" name="source" value={Astro.url.pathname} />
  <input type="hidden" name="placement" value={placement} />
  <input type="hidden" name="consent_version" value={version} />
  <div class="hidden" aria-hidden="true">
    <label for={`${id}-site`}>{t('forms.honeypot')}</label>
    <input id={`${id}-site`} name="site_web" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <label for={`${id}-courriel`} class:list={['block text-sm font-semibold', variant === 'band' && 'sr-only']}>{texts.emailLabel}</label>
  <div class:list={['flex gap-2', stacked ? 'flex-col' : 'flex-col sm:flex-row']}>
    <input id={`${id}-courriel`} name="email" type="email" required maxlength="254" autocomplete="email" class="input" placeholder={texts.emailPlaceholder} />
    <Button type="submit" variant={inverse ? 'inverse' : 'primary'} class="shrink-0">{texts.button}</Button>
  </div>
  <div class="flex items-start gap-2 text-sm">
    <input id={`${id}-consentement`} name="consent" type="checkbox" value="oui" required class="mt-1 size-4 shrink-0" />
    <label for={`${id}-consentement`} class={inverse ? 'text-meta-inverse' : 'text-secondary'}>
      {consent}
      <a href={texts.privacyUrl} class="font-semibold underline underline-offset-2">{texts.privacyLinkLabel}</a>
    </label>
  </div>
  <div data-turnstile></div>
  <p class="form-status text-sm" aria-live="polite" data-form-status></p>
  <noscript><p class="text-sm">{t('forms.noscript')}</p></noscript>
</form>

<script>
  import { enhanceForms } from '../../lib/forms/client.ts';

  enhanceForms();
</script>
