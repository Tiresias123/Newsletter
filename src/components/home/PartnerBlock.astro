---
// Bloc partenaire : affiché seulement s'il est activé dans config/ads.json, toujours signalé « Publicité ».
import { getConfig } from '../../lib/config/index.ts';
import { t } from '../../lib/i18n.ts';
import HomeSection from './HomeSection.astro';

interface Props {
  id: string;
  partnerId: string;
  placement: 'article' | 'sidebar' | 'home' | 'newsletter';
}

const { id, partnerId, placement } = Astro.props;
const { ads } = getConfig();
const partner = ads.enabled ? ads.partners.find((p) => p.id === partnerId && p.enabled && p.placement.includes(placement)) : undefined;
---

{
  partner && (
    <HomeSection id={id}>
      <aside class="rounded-card border border-border bg-muted p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-meta">{partner.disclosure || t('partner.disclosure')}</p>
        <a href={partner.url} rel="sponsored noopener" class="mt-2 inline-block text-lg font-semibold underline underline-offset-4">
          {partner.campaign || partner.name}
        </a>
      </aside>
    </HomeSection>
  )
}
