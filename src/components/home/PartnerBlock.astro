---
// Section d'accueil « partenaire » : le bloc générique, dans le cadre commun des sections.
import { activePartner } from '../../lib/partners.ts';
import PartnerBlock from '../editorial/PartnerBlock.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  id: string;
  partnerId: string;
}

const { id, partnerId } = Astro.props;
---

{
  activePartner(partnerId, 'home') && (
    <HomeSection id={id}>
      <PartnerBlock partnerId={partnerId} placement="home" />
    </HomeSection>
  )
}
