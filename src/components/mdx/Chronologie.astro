---
// Bloc Chronologie : frise verticale des étapes saisies dans le corps.
import { blockSchemas, parseBlock } from '../../lib/content/block-props.ts';
import { t } from '../../lib/i18n.ts';
import Timeline from '../editorial/Timeline.astro';

