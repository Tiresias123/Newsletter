---
// Statut réglementaire d'un dossier lié : puce de statut et lien vers le dossier. Élément en ligne, valide
// au milieu d'une phrase comme seul sur sa ligne.
import { getGraph } from '../../lib/content/astro.ts';
import type { LegalStatus } from '../../lib/content/enums.ts';
import { frenchTypography } from '../../lib/typo.ts';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  dossier: string;
}

const graph = await getGraph();
const entry = graph.get('dossiers', Astro.props.dossier);
---

{
  entry?.visibility.visible && (
    <span class="not-prose inline-flex flex-wrap items-center gap-2 align-middle">
      <StatusBadge status={entry.data.legalStatus as LegalStatus} />
      <a href={entry.url} class="text-link font-semibold">
        {frenchTypography(entry.data.shortTitle || entry.data.title)}
      </a>
    </span>
  )
}
