---
// Bloc de page ListeSources : les sources réutilisables, toutes ou filtrées (identifiants, juridiction, type).
import { blockSchemas, parseBlock } from '../../lib/content/block-props.ts';
import { getGraph } from '../../lib/content/astro.ts';
import { reusableSources } from '../../lib/content/sources.ts';
import SourceList from '../editorial/SourceList.astro';

interface Props {
  ids?: unknown;
  jurisdiction?: string;
  type?: string;
}

const { ids, jurisdiction, type } = Astro.props;
const graph = await getGraph();
// Une liste vide (« ids={[]} », que l'éditeur écrit toujours) vaut « pas de sélection » : toutes les sources filtrées.
const chosen = ids === undefined ? [] : parseBlock('ListeSources', blockSchemas.ids, ids);
const items = reusableSources(graph, { ids: chosen.length > 0 ? chosen : undefined, jurisdiction: jurisdiction || undefined, type: type || undefined });
---

<div class="my-8"><SourceList items={items} /></div>
