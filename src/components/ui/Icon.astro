---
// Icône Lucide rendue en SVG au build (aucun JavaScript). Liste fermée : src/lib/icons.ts.
// Décorative par défaut (aria-hidden) ; passer `label` quand l'icône porte seule le sens.
import type { IconName } from '../../lib/icons.ts';
import { ICONS } from './icon-map.ts';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const Component = ICONS[name];
---

<Component
  size={size}
  stroke-width={1.75}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
/>
