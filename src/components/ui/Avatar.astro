---
// Photo de l'auteur, ou ses initiales si aucune photo n'est fournie. Décorative : le nom est à côté.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  src?: unknown;
  size?: 24 | 32 | 64;
}

const { name, src, size = 24 } = Astro.props;
const SIZES = { 24: 'size-6 text-[10px]', 32: 'size-8 text-xs', 64: 'size-16 text-2xl' } as const;
const initials = name
  .replace(/\[[^\]]*\]/g, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');
---

{
  src ? (
    <Image src={src as ImageMetadata} alt="" width={size} height={size} class="shrink-0 rounded-full object-cover" />
  ) : (
    <span
      aria-hidden="true"
      class:list={['inline-flex shrink-0 items-center justify-center rounded-full bg-secondary-bg font-heading font-bold text-secondary-fg', SIZES[size]]}
    >
      {initials}
    </span>
  )
}
