---
// Filtres d'un hub (DA, maquettes 12.5 et 12.6) : thème, format, juridiction. Formulaire simple, sans script,
// qui mène à /recherche/ avec la catégorie et les filtres présélectionnés (ARCHITECTURE, section 10).
// Replié sur mobile ; ouvert d'office sur ordinateur par un script d'une ligne (replié sans JavaScript).
import { getGraph } from '../../lib/content/astro.ts';
import { t } from '../../lib/i18n.ts';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  // Filtres fixés par la page (par exemple { categorie: 'reglementation' }).
  fixed?: Record<string, string>;
  id?: string;
}

const { fixed = {}, id = 'filtres' } = Astro.props;
const graph = await getGraph();
const byOrder = <T extends { data: { order: number; label: string } }>(a: T, b: T) => a.data.order - b.data.order || a.data.label.localeCompare(b.data.label, 'fr-CA');
const fields = [
  { name: 'theme', label: t('filters.theme'), all: t('filters.all'), options: graph.all('themes').sort(byOrder).map((e) => ({ value: e.id, label: e.data.label })) },
  { name: 'format', label: t('filters.format'), all: t('filters.all'), options: graph.all('formats').sort(byOrder).map((e) => ({ value: e.id, label: e.data.label })) },
  {
    name: 'juridiction',
    label: t('filters.jurisdiction'),
    all: t('filters.allFeminine'),
    options: graph
      .listed('juridictions')
      .sort((a, b) => a.data.order - b.data.order)
      .map((e) => ({ value: e.id, label: e.data.name })),
  },
].filter((field) => !(field.name in fixed) && field.options.length > 0);
// Classes écrites en entier pour que Tailwind les génère (aucun style en ligne : compatible avec une CSP stricte).
const COLUMNS: Record<number, string> = {
  1: 'lg:grid-cols-[minmax(0,1fr)_auto]',
  2: 'lg:grid-cols-[repeat(2,minmax(0,1fr))_auto]',
  3: 'lg:grid-cols-[repeat(3,minmax(0,1fr))_auto]',
};
---

<details class="filter-form rounded-card border border-border bg-surface print:hidden" data-open-desktop data-pagefind-ignore>
  <summary class="flex cursor-pointer items-center gap-2 p-4 font-heading font-bold">
    <Icon name="funnel" size={18} />
    {t('filters.title')}
  </summary>
  <form action="/recherche/" method="get" class:list={['grid gap-4 p-4 pt-0 sm:grid-cols-2 lg:items-end', COLUMNS[fields.length]]} aria-label={t('filters.title')}>
    {Object.entries(fixed).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    {
      fields.map((field) => (
        <div class="space-y-1">
          <label for={`${id}-${field.name}`} class="text-sm font-semibold">
            {field.label}
          </label>
          <select id={`${id}-${field.name}`} name={field.name} class="input">
            <option value="">{field.all}</option>
            {field.options.map((o) => (
              <option value={o.value}>{o.label}</option>
            ))}
          </select>
        </div>
      ))
    }
    <Button type="submit" iconAfter="arrow-right">{t('filters.submit')}</Button>
  </form>
</details>

<script>
  // Sur ordinateur, les filtres sont visibles d'emblée ; sur mobile, ils restent repliés.
  if (matchMedia('(min-width: 64rem)').matches) for (const el of document.querySelectorAll('details[data-open-desktop]')) el.setAttribute('open', '');
</script>
