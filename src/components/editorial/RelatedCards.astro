---
// Articles liés (brief 7.2, étape 18) : six cartes, grille de trois colonnes sur ordinateur, liste compacte
// sur mobile. Exclu de l'index de recherche.
import type { CardModel } from '../../lib/content/cards.ts';
import ArticleCard from '../cards/ArticleCard.astro';

interface Props {
  title: string;
  cards: CardModel[];
  id?: string;
}

const { title, cards, id = 'articles-lies' } = Astro.props;
---

{
  cards.length > 0 && (
    <section aria-labelledby={id} class="mt-16 border-t border-border pt-10 print:hidden" data-pagefind-ignore>
      <h2 id={id} class="text-2xl">
        {title}
      </h2>
      <ul class="mt-6 hidden gap-6 sm:grid sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((card) => (
          <li>
            <ArticleCard card={card} variant="medium" level={3} />
          </li>
        ))}
      </ul>
      <ul class="mt-4 divide-y divide-subtle sm:hidden">
        {cards.map((card) => (
          <li class="py-3">
            <ArticleCard card={card} variant="compact" level={3} surface="plain" />
          </li>
        ))}
      </ul>
    </section>
  )
}
