---
// Encadré de points clés : « L'essentiel » d'un article (brief 7.2, étape 9, de trois à cinq points) ou
// « Ce qui change » d'un dossier (famille info forte, comme le Callout du même nom). Masqué s'il est vide.
import { t } from '../../lib/i18n.ts';
import { frenchTypography } from '../../lib/typo.ts';

interface Props {
  points: string[];
  title?: string;
  // Ancre de la section (sommaire) ; le titre reçoit « <id>-titre ».
  id?: string;
  family?: 'info' | 'strong';
  class?: string;
}

const { points, title = t('editorial.keyPoints'), id = 'essentiel', family = 'info', class: className = 'my-8' } = Astro.props;
---

{
  points.length > 0 && (
    <section id={id} class:list={['callout scroll-mt-24', `callout--${family}`, className]} aria-labelledby={`${id}-titre`}>
      <h2 id={`${id}-titre`} class="callout-title text-lg">
        {frenchTypography(title)}
      </h2>
      <div class="callout-body">
        <ul>
          {points.map((point) => (
            <li>{frenchTypography(point)}</li>
          ))}
        </ul>
      </div>
    </section>
  )
}
