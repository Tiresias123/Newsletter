---
// Bloc d'infolettre avec titre et promesse, lus dans config/newsletter.json : compact en barre latérale,
// en ligne en fin d'article.
import { getConfig } from '../../lib/config/index.ts';
import { frenchTypography } from '../../lib/typo.ts';
import NewsletterForm from '../newsletter/NewsletterForm.astro';

interface Props {
  id?: string;
  variant?: 'compact' | 'inline';
  // Liste d'inscription (config/newsletter.json) ; la liste générale par défaut.
  list?: string;
}

const { id = 'barre-infolettre', variant = 'compact', list } = Astro.props;
const { newsletter } = getConfig();
// En ligne (fin d'article, bloc de page), une région nommée ; en barre latérale, déjà dans le repère « aside »,
// un simple bloc : deux régions portant le même titre seraient indistinctes pour un lecteur d'écran.
const Container = variant === 'inline' ? 'section' : 'div';
---

<Container
  class:list={['rounded-card border border-border p-5 print:hidden', variant === 'inline' ? 'bg-muted sm:p-6' : 'bg-surface']}
  aria-labelledby={variant === 'inline' ? `${id}-titre` : undefined}
  data-pagefind-ignore
>
  <h2 id={`${id}-titre`} class:list={[variant === 'inline' ? 'text-xl' : 'text-lg']}>{frenchTypography(newsletter.texts.title)}</h2>
  <p class="mb-4 mt-1 text-sm text-secondary">{frenchTypography(newsletter.texts.subtitle)}</p>
  <NewsletterForm id={id} variant={variant} list={list} />
</Container>
