    "astro": "7.3.5",
    "js-yaml": "4.3.2",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.6",
