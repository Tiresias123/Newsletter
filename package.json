{
  "name": "media-cryptoactifs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Média sur la réglementation et la fiscalité des cryptoactifs au Canada et au Québec.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build && pagefind && node scripts/postbuild.ts",
    "preview": "astro preview",
    "check": "node --env-file-if-exists=.env scripts/check.ts",
    "new:article": "node scripts/new-article.ts",
    "newsletter:draft": "node scripts/newsletter-draft.ts",
    "content:format": "node scripts/content-format.ts",
    "surveillance": "node scripts/surveillance.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@lucide/astro": "1.48.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "js-yaml": "4.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.33.5",
    "satteri": "0.10.5",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
